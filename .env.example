# BotWhatsApp — EXEMPLO, nenhum segredo no Git. NÃO é ativação de produção.
BOT_ENABLED=false
BOT_OUTBOUND_ENABLED=false
BOT_OPERATIONAL_AUTHORIZATION=false

# Bind host local por padrão. Container futuro deve usar rede privada e
# firewall/proxy com acesso restrito; não abrir 0.0.0.0 na VPS indiscriminadamente.
BOT_LISTEN_ADDR=127.0.0.1:8788
BOT_DATA_DIR=./data/spool
BOT_TENANT=estudio-evydencia

# Cada role pode ser provisionada separadamente. UUIDs NÃO são telefones.
BOT_ADS_INSTANCE_UUID=
BOT_GREETING_INSTANCE_UUID=
BOT_ADS_PHONE=554832200440
BOT_GREETING_PHONE=5548996425287
BOT_ADS_WEBHOOK_SECRET=
BOT_GREETING_WEBHOOK_SECRET=

# Frases EXATAS do anúncio separadas por |. Não há gatilhos genéricos padrão.
BOT_ADS_TRIGGERS=
BOT_ADS_FALLBACK_MENU=false
BOT_ADS_RESPONSE_TEXT=

# Montar mídias reais em volume privado. Se vazias, a etapa de mídia é SUPPRESSED,
# sem simular áudio/foto nem bloquear a tentativa do CRM após aprovação comercial.
BOT_ADS_AUDIO_FILE=
BOT_GREETING_IMAGE_FILE=
BOT_GREETING_CAPTION_FILE=

# Evolution Go 0.7.2 — uma APIKEY DIFERENTE por instância.
EVOLUTION_GO_BASE_URL=
EVOLUTION_ADS_APIKEY=
EVOLUTION_GREETING_APIKEY=

# CRM SEM NOME = campanha 416 fixa no código; sem fallback para campanha 415.
# RAW Authorization, sem Bearer. Instância de SAÍDA CRM numérica explícita.
EVIDENCIA_CRM_BASE_URL=https://evydencia.com
EVIDENCIA_CRM_AUTHORIZATION=
EVIDENCIA_CRM_OUTBOUND_MESSAGE_INSTANCE_ID=

# NOVO serviço sidecar OPCIONAL. DESLIGADO até homologação separada.
# O destino atual do status-engine permanece 8050 e NUNCA é movido.
RELAY_ENABLED=false
RELAY_LISTEN_ADDR=127.0.0.1:8789
RELAY_DATA_DIR=./data/relay
RELAY_MAX_EVENTS=20000
RELAY_EXPECTED_INSTANCE_UUID=
RELAY_INGRESS_SECRET=
# URL HTTP interna do consumidor EXISTENTE (exemplo do inventário anterior):
RELAY_STATUS_URL=
# URL interna do bot com seu webhook de Ads e segredo independente.
RELAY_BOT_URL=
